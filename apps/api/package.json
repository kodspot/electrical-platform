{
  "name": "electrical-api",
  "version": "1.0.0",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "security:audit": "npm audit --omit=dev",
    "security:audit:fix": "npm audit fix --omit=dev",
    "prestart": "npm audit --omit=dev --audit-level=critical || echo 'WARNING: Critical vulnerabilities found — run npm audit fix'",
    "test": "node scripts/run-tests.js",
    "test:phase1": "node scripts/run-tests.js test/phase1-acceptance.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:routes:check": "node scripts/check-routes-drift.js",
    "docs:bugs": "node scripts/gen-bug-registry.js",
    "bug:test": "node scripts/run-tests.js test/integration/bug-regressions.test.js",
    "verify": "npm run lint && npm test && npm run docs:routes:check",
    "ci": "npm run lint && npm test && node scripts/ci-validate.js",
    "release:check": "node scripts/ci-validate.js --release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docs:routes": "node scripts/gen-route-index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.9.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.3.1",
    "fastify": "^4.26.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.18.0",
    "prisma": "^5.9.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.9.5"
  }
}
