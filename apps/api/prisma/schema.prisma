generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id   String  @id @default(uuid())
  name String
  slug String  @unique
  type String? // "hospital", "hotel", "office", etc.

  address        String?
  phone          String?
  email          String?
  logoUrl        String?
  enabledModules String[] @default(["ele"])

  // AI Assistant settings (managed by superadmin only)
  aiEnabled           Boolean   @default(false)
  aiProvider          String? // "azure-openai" | "gemini"
  aiModel             String? // e.g. "gpt-4o", "gemini-2.0-flash"
  aiApiKey            String? // Encrypted with DATA_ENCRYPTION_KEY
  aiApiKeyLastUsedAt  DateTime?
  aiMonthlyTokenLimit Int?      @default(100000) // soft cap per month
  aiTotalTokensUsed   Int       @default(0) // reset monthly by scheduler

  status OrgStatus @default(ACTIVE)

  users                 User[]
  workers               Worker[]
  locations             Location[]
  tickets               Ticket[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  shiftConfigs          ShiftConfig[]
  workerAssignments     WorkerAssignment[]
  supervisorAssignments SupervisorAssignment[]
  attendance            Attendance[]
  dutyRosters           DutyRoster[]
  aiUsageLogs           AiUsageLog[]
  inspectionTemplates   InspectionTemplate[]
  electricalInspections ElectricalInspection[]
  assets                Asset[]
  assetEvents           AssetEvent[]
  assetFailures         AssetFailure[]
  alertRules            AlertRule[]
  alerts                Alert[]
  aiInsights            AiInsight[]
  complaintCategories   ComplaintCategory[]
  moduleActivations     OrgModuleActivation[]

  deletedAt  DateTime?
  purgeAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ModuleDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isCore      Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  dependencies ModuleDependency[] @relation("ModuleDependencyFrom")
  requiredBy   ModuleDependency[] @relation("ModuleDependencyTo")
  orgActivations OrgModuleActivation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // F13: the database has this default (migrations); declared so schema = database

  @@index([isActive, sortOrder])
}

model ModuleDependency {
  id String @id @default(uuid())

  moduleId String
  module   ModuleDefinition @relation("ModuleDependencyFrom", fields: [moduleId], references: [id], onDelete: Cascade)

  dependsOnModuleId String
  dependsOnModule   ModuleDefinition @relation("ModuleDependencyTo", fields: [dependsOnModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([moduleId, dependsOnModuleId])
  @@index([dependsOnModuleId])
}

model OrgModuleActivation {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  moduleId String
  module   ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  activatedAt DateTime @default(now())
  activatedById String?

  deactivatedAt DateTime?
  deactivatedById String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // F13: the database has this default (migrations); declared so schema = database

  @@unique([orgId, moduleId])
  @@index([orgId, isActive])
}

model User {
  id    String        @id @default(uuid())
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  designation  String?
  employeeId   String?
  department   String?
  gender       String?
  bloodGroup   String?
  dateOfBirth  DateTime?
  dateOfJoin   DateTime?
  address      String?
  aadharNo     String?
  notes        String?
  passwordHash String
  role         UserRole

  isActive           Boolean   @default(true)
  tokenInvalidBefore DateTime?

  // Self-service password reset (WP14) — single-use, time-limited token
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  ticketsCreated        Ticket[]               @relation("TicketCreatedBy")
  ticketsAssigned       Ticket[]               @relation("TicketAssignedTo")
  ticketsVerified       Ticket[]               @relation("TicketVerifiedBy")
  notifications         Notification[]
  attendanceMarked      Attendance[]           @relation("AttendanceMarkedBy")
  dutyRosters           DutyRoster[]           @relation("DutyRosterSupervisor")
  electricalInspections ElectricalInspection[] @relation("ElectricalInspector")
  assetEventsLogged     AssetEvent[]            @relation("AssetEventLogger")
  assetFailuresLogged   AssetFailure[]          @relation("AssetFailureLogger")
  assetFailuresResolved AssetFailure[]          @relation("AssetFailureResolver")
  supervisorAssignments SupervisorAssignment[]  @relation("SupervisorLocations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([orgId, role])
  @@index([orgId, isActive])
  @@index([email])
}

model Worker {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  employeeId  String? // Unique worker ID within org (e.g., EMP-001)
  name        String
  phone       String?
  email       String?
  address     String?
  department  String? // e.g., "Electrical", "Maintenance"
  designation String? // e.g., "Electrician", "Floor Supervisor"
  dateOfBirth DateTime?
  dateOfJoin  DateTime?
  gender      String? // "Male", "Female", "Other"
  bloodGroup  String?
  aadharNo    String? // ID proof
  notes       String?
  pinHash     String? // Hashed 4-6 digit PIN for worker login
  tokenInvalidBefore DateTime? // Reject tokens issued before this timestamp
  isActive    Boolean   @default(true)

  // Self-service PIN reset (WP14) — single-use, time-limited token
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  ticketsResolved       Ticket[]               @relation("TicketResolvedWorkers")
  assignments           WorkerAssignment[]
  attendance            Attendance[]
  dutyRosterAssignments DutyRosterWorker[]
  electricalInspections ElectricalInspection[]
  notifications         Notification[]         @relation("WorkerNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, employeeId])
  @@index([orgId, isActive])
}

model Location {
  id       String       @id @default(uuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[]   @relation("LocationHierarchy")

  name      String
  type      LocationType
  qrCode    String       @unique
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  notes     String?

  tickets               Ticket[]
  workerAssignments     WorkerAssignment[]
  supervisorAssignments SupervisorAssignment[]
  dutyRosters           DutyRoster[]
  electricalInspections ElectricalInspection[]
  assets                Asset[]
  hostelComplaintCategories ComplaintCategory[] @relation("HostelComplaintCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, parentId])
  @@index([orgId, type])
  @@index([orgId, isActive])
}

model Ticket {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdById  String?
  // F13: RESTRICT, as the database has it: a user who created tickets cannot be hard-deleted
  // (routes/supervisors.js pre-checks and answers 409).
  createdBy    User?    @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId String?
  assignedTo   User?    @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  title       String
  description String?
  imageUrl    String?
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  source      String         @default("INTERNAL") // INTERNAL or PUBLIC
  module      String         @default("ele") // ele, civil, asset, complaints
  guestName   String?
  guestPhone  String?
  issueType   String? // Module-specific issue type

  resolvedImageUrl String?
  resolvedNote     String?
  resolvedWorkers  Worker[]  @relation("TicketResolvedWorkers")
  resolvedAt       DateTime?

  // SLA tracking
  slaDeadlineAt    DateTime?  // Computed at creation based on priority
  slaBreachedAt    DateTime?  // Set when SLA breach is detected
  acceptedAt       DateTime?  // When work was started

  // Complaint provenance (privacy-safe)
  sourceIp         String?    // SHA-256 hash prefix (first 16 chars) — not reversible
  userAgent        String?    // Browser UA truncated to 200 chars
  riskScore        Int        @default(0) // 0-100 computed risk (duplicate/spam detection)

  // Supervisor verification after worker resolution
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?      @relation("TicketVerifiedBy", fields: [verifiedById], references: [id])
  verifyNote       String?

  // Public review fields
  reviewToken     String?   @unique
  reviewExpiresAt DateTime?
  reviewStatus    String? // PENDING, CONFIRMED, REJECTED
  reviewNote      String? // Guest comment when confirming/rejecting
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, locationId])
  @@index([assignedToId, status])
  @@index([orgId, createdAt])
  @@index([orgId, source])
  @@index([orgId, module, status])
  // F13: created by migration 20260426000000_phase1_sla_verify_provenance, now declared.
  @@index([sourceIp, createdAt]) // public-complaint duplicate scoring (routes/public.js)
  @@index([slaDeadlineAt, status])
  @@index([orgId, status, verifiedAt])
}

model ComplaintCategory {
  id String @id @default(uuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  module      String  @default("ele") // ele, civil, asset, complaints
  key         String  // canonical issue key used in Ticket.issueType
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  // Optional hostel-level override; null means org-wide category.
  hostelLocationId String?
  hostelLocation   Location? @relation("HostelComplaintCategories", fields: [hostelLocationId], references: [id], onDelete: SetNull)

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, module, isActive, sortOrder])
  @@index([orgId, hostelLocationId])
  @@index([orgId, module, key])
}

model AuditLog {
  id    String        @id @default(uuid())
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  actorType String
  actorId   String?

  action String

  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id     String        @id @default(uuid())
  orgId  String
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId String?
  worker   Worker?     @relation("WorkerNotifications", fields: [workerId], references: [id], onDelete: Cascade)

  type     String // ticket_assigned, ticket_created, ticket_resolved, public_complaint, alert_*, escalation
  title    String
  body     String?
  entityId String? // ticket id or other entity
  isRead   Boolean @default(false)
  isUrgent Boolean @default(false) // Persistent alert — requires acknowledgement

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([workerId, isRead])
  @@index([orgId, createdAt])
}

model ShiftConfig {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  shift     Shift
  startHour Int // 0-23
  startMin  Int     @default(0) // 0-59
  endHour   Int // 0-23
  endMin    Int     @default(0) // 0-59
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, shift])
  @@index([orgId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LocationType {
  BUILDING
  FLOOR
  ROOM
  CORRIDOR
  WASHROOM
  ICU
  LOBBY
  KITCHEN
  WARD
  MEETING_ROOM
  HOSTEL
  SUBSTATION
  PANEL_ROOM
  GENERATOR_ROOM
  TRANSFORMER
  UTILITY_AREA
  LAB
  SERVER_ROOM
  STAIRCASE
  TERRACE
  PARKING
  CANTEEN
  AUDITORIUM
  LIBRARY
  OFFICE
  STORE_ROOM
  PUMP_ROOM
  LIFT_ROOM
  RECEPTION
  COMMON_AREA
  OTHER
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
  GENERAL
}

enum InspectionStatus {
  SUBMITTED
  FLAGGED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED_PENDING_VERIFY
  RESOLVED
  CANCELLED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  FAULTY
  DECOMMISSIONED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum AssetEventType {
  INSTALLED
  INSPECTED
  MAINTAINED
  REPAIRED
  RELOCATED
  DECOMMISSIONED
  RECOMMISSIONED
  NOTE
}

enum FailureSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FailureStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AlertTrigger {
  INSPECTION_FAULT
  INSPECTION_LATE
  INSPECTION_MISSED
  ASSET_FAILURE_REPORTED
  ASSET_FAILURE_UNRESOLVED
  ASSET_MAINTENANCE_OVERDUE
  TICKET_HIGH_PRIORITY
  ATTENDANCE_LOW
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

model WorkerAssignment {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  isPrimary     Boolean @default(true)
  coverChildren Boolean @default(true) // true = covers all child locations (floors/rooms under a hostel)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, locationId])
  @@index([orgId])
  @@index([locationId])
  @@index([workerId])
}

model SupervisorAssignment {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  supervisorId String
  supervisor   User     @relation("SupervisorLocations", fields: [supervisorId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  coverChildren Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // F13: the database has this default (migrations); declared so schema = database

  @@unique([supervisorId, locationId])
  @@index([orgId])
  @@index([locationId])
  @@index([supervisorId])
}

model Attendance {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  workerId   String
  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  markedById String
  markedBy   User   @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  date   DateTime         @db.Date
  shift  Shift
  status AttendanceStatus

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, date, shift])
  @@index([orgId, date])
  @@index([workerId, date])
  @@index([markedById])
}

model DutyRoster {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date
  shift        Shift
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  supervisorId String
  supervisor   User     @relation("DutyRosterSupervisor", fields: [supervisorId], references: [id])

  workers DutyRosterWorker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, date, shift, supervisorId])
  @@index([orgId, date])
  @@index([orgId, date, shift, locationId])
}

model DutyRosterWorker {
  id       String     @id @default(uuid())
  rosterId String
  roster   DutyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  workerId String
  worker   Worker     @relation(fields: [workerId], references: [id])

  @@unique([rosterId, workerId])
  @@index([workerId])
}

model AiUsageLog {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId       String
  action       String // "chat" | "analyze"
  prompt       String? // first 200 chars of user message
  provider     String // "gemini" | "azure-openai"
  model        String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  latencyMs    Int? // response time in milliseconds
  success      Boolean @default(true)
  errorCode    String? // AI_AUTH_ERROR, AI_RATE_LIMIT, etc.
  keySource    String  @default("org") // "org" | "global"

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@index([userId, createdAt])
}

// ── Asset Management Module ──

model Asset {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  assetCode  String  // Unique within org, e.g. "ELE-TFR-001"
  name       String  // "Main Transformer", "Panel Board A"
  category   String  // "Transformer", "Panel", "Generator", "UPS", "Motor", "Cable", etc.
  make       String? // Manufacturer
  model      String? // Model number
  serialNo   String? // Manufacturer serial
  ratedCapacity String? // "100 KVA", "32A", "415V"
  description  String?
  imageUrl     String?

  status    AssetStatus    @default(OPERATIONAL)
  condition AssetCondition @default(GOOD)

  installDate       DateTime? @db.Date
  warrantyExpiry    DateTime? @db.Date
  lastMaintenanceAt DateTime?
  nextMaintenanceDue DateTime? @db.Date
  maintenanceCycleDays Int?    // e.g. 90 = quarterly

  purchaseCost Float?
  metadata     Json?   // Flexible key-value for custom fields

  isActive Boolean @default(true)

  events   AssetEvent[]
  failures AssetFailure[]
  images   AssetImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, assetCode])
  @@index([orgId, status])
  @@index([orgId, category])
  @@index([orgId, locationId])
  @@index([orgId, isActive])
  @@index([orgId, nextMaintenanceDue])
}

model AssetEvent {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assetId  String
  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  loggedById String
  loggedBy   User @relation("AssetEventLogger", fields: [loggedById], references: [id])

  type     AssetEventType
  summary  String   // Short description: "Quarterly maintenance completed"
  details  String?  // Longer notes
  cost     Float?   // Cost of maintenance/repair if applicable
  imageUrl String?  // Evidence photo

  // Snapshot at time of event
  statusBefore    AssetStatus?
  statusAfter     AssetStatus?
  conditionBefore AssetCondition?
  conditionAfter  AssetCondition?

  eventDate DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([assetId, eventDate])
  @@index([orgId, eventDate])
  @@index([orgId, type])
}

model AssetFailure {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  assetId    String
  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  loggedById String
  loggedBy   User @relation("AssetFailureLogger", fields: [loggedById], references: [id])

  title       String   // "Phase R failure", "Oil leak detected"
  description String?
  cause       String?  // Root cause (filled on resolution)
  severity    FailureSeverity @default(MEDIUM)
  status      FailureStatus   @default(OPEN)

  failedAt   DateTime @default(now()) // When the failure occurred
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User? @relation("AssetFailureResolver", fields: [resolvedById], references: [id])
  resolution     String? // Resolution notes
  resolutionCost Float?

  downtime Int? // Total downtime in minutes once resolved

  images AssetFailureImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, status])
  @@index([orgId, status])
  @@index([orgId, severity])
  @@index([orgId, failedAt])
}

model AssetImage {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  imageUrl String
  caption  String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([assetId])
}

model AssetFailureImage {
  id        String       @id @default(uuid())
  failureId String
  failure   AssetFailure @relation(fields: [failureId], references: [id], onDelete: Cascade)

  imageUrl String
  caption  String?
  type     String @default("REPORT") // REPORT (when logging) or RESOLUTION (when resolving)

  createdAt DateTime @default(now())

  @@index([failureId])
}

// ── Alert + Automation ──

model AlertRule {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  description String?
  trigger     AlertTrigger
  conditions  Json   // Trigger-specific: { minFaults:3, minSeverity:'HIGH', hoursOpen:24, ... }
  actions     Json   // Action list: [{ type:'NOTIFY_ADMINS' }, { type:'CREATE_TICKET', priority:'HIGH' }]

  // Escalation policy
  escalateAfterMinutes Int?  // If alert not acknowledged within N minutes, escalate
  escalationActions    Json? // Actions on escalation: [{ type:'NOTIFY_ADMINS' }, { type:'CREATE_TICKET' }]
  maxEscalations       Int?  @default(1) // Max escalation rounds

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts Alert[]

  @@index([orgId, isActive])
  @@index([orgId, trigger])
}

model Alert {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  trigger    AlertTrigger
  severity   AlertSeverity @default(WARNING)
  title      String
  body       String?

  entityType String? // 'inspection', 'asset', 'failure', 'ticket'
  entityId   String?
  metadata   Json?
  actionsRun Json?   // Snapshot of executed actions

  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?

  // Escalation tracking
  escalationLevel  Int       @default(0)  // 0 = not escalated, 1+ = escalation rounds
  lastEscalatedAt  DateTime?

  dedupKey  String? // Prevents duplicate alerts
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, acknowledged, createdAt])
  @@index([orgId, trigger])
  @@unique([orgId, dedupKey])
}

model AiInsight {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  type    String  // 'daily_summary', 'weekly_report', 'anomaly', 'trend_alert'
  title   String
  content String  // AI-generated markdown
  metadata Json?  // tokens used, model, latency
  period  String? // '2026-04-06', '2026-W14'

  isRead  Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([orgId, type, createdAt])
  @@unique([orgId, type, period])
}

// ── Inspection Templates ──

model InspectionTemplate {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name          String // e.g. "Standard Room Inspection", "MCB Panel Deep Check"
  description   String?
  locationTypes String[] @default([]) // Empty = all types; otherwise filter e.g. ["ROOM","WARD"]. F13: DB default declared
  isDefault     Boolean  @default(false) // One default per org — auto-selected when no specific match
  isActive      Boolean  @default(true)
  version       Int      @default(1) // Incremented on edit so historical inspections keep old snapshot
  sortOrder     Int      @default(0)

  items       InspectionTemplateItem[]
  inspections ElectricalInspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, isActive])
  @@index([orgId, isDefault])
}

model InspectionTemplateItem {
  id         String             @id @default(uuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label       String // e.g. "Lighting", "MCB Panel", "Earth Resistance"
  checkKey    String // Machine key: LIGHTING, FAN, CUSTOM_1, etc.
  responseType String @default("STATUS") // STATUS (OK/FAULTY/NA), READING (numeric), YES_NO
  unit        String? // For READING type: "V", "Ω", "A", etc.
  minValue    Float?  // For READING type: acceptable min
  maxValue    Float?  // For READING type: acceptable max
  isRequired  Boolean @default(true)
  sortOrder   Int     @default(0)

  inspectionItems ElectricalInspectionItem[]

  @@index([templateId])
}

// ── Electrical Module ──

model ElectricalInspection {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   User     @relation("ElectricalInspector", fields: [supervisorId], references: [id])
  templateId   String?
  template     InspectionTemplate? @relation(fields: [templateId], references: [id])

  workers Worker[]
  images  ElectricalImage[]
  items   ElectricalInspectionItem[]

  shift  Shift            @default(GENERAL)
  notes  String?
  status InspectionStatus @default(SUBMITTED)

  expectedShift Shift?
  isLate        Boolean @default(false)
  lateReason    String?
  flagReason    String?

  faultyCount Int @default(0) // Cached count of FAULTY items

  inspectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, inspectedAt])
  @@index([orgId, locationId])
  @@index([supervisorId, inspectedAt])
  @@index([orgId, status])
  @@index([templateId])
}

model ElectricalInspectionItem {
  id           String               @id @default(uuid())
  inspectionId String
  inspection   ElectricalInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  templateItemId String?
  templateItem   InspectionTemplateItem? @relation(fields: [templateItemId], references: [id])

  checkType String // LIGHTING, FAN, AC, etc. (from template checkKey or legacy)
  status    String // OK, FAULTY, NA
  remarks   String?
  reading   Float? // For READING response type

  @@index([inspectionId])
  @@index([templateItemId])
}

model ElectricalImage {
  id           String               @id @default(uuid())
  inspectionId String
  inspection   ElectricalInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  imageUrl String
  caption  String?

  createdAt DateTime @default(now())

  @@index([inspectionId])
}

/// Platform-level QA telemetry: one row per test run (CI, local or e2e), shown on the
/// super-admin Quality page. Deliberately NOT tenant-scoped — it describes the platform's
/// code, not any organization's data, and is readable only by SUPER_ADMIN. Written only by
/// the token-authenticated ingest (POST /api/qa/runs), which keeps the newest 500 rows.
/// [WP-Q, ADR 0005]
model QaRun {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  source      String // 'ci' | 'local' | 'e2e'
  commitSha   String?
  ref         String?
  event       String?
  runUrl      String?
  nodeVersion String?
  status      String
  total       Int      @default(0)
  passed      Int      @default(0)
  failed      Int      @default(0)
  cancelled   Int      @default(0)
  skipped     Int      @default(0)
  todo        Int      @default(0)
  durationMs  Int?
  details     Json?

  @@index([createdAt])
  @@index([source, createdAt])
}
