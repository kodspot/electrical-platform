# ═══════════════════════════════════════════════════════
# Kodspot Electrical Platform — Environment Variables
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://electrical.kodspot.in
COOKIE_DOMAIN=electrical.kodspot.in

# ── Database (PostgreSQL) ────────────────────────────
DB_USER=electrical
DB_PASSWORD=<STRONG_RANDOM_PASSWORD>
DB_NAME=electrical
DATABASE_URL=postgresql://electrical:<STRONG_RANDOM_PASSWORD>@db:5432/electrical
# Connection pool sizing defaults to connection_limit=10&pool_timeout=10 if not
# already present in DATABASE_URL above (see src/lib/prisma.js). Running more than
# one app instance against the same database? Lower connection_limit per instance so
# instances × connection_limit stays under Postgres's own max_connections — e.g.
# postgresql://...db?connection_limit=5&pool_timeout=10 — see docs/SCALING.md.

# ── Auth Secrets ─────────────────────────────────────
JWT_SECRET=<RANDOM_64_CHAR_HEX>
COOKIE_SECRET=<RANDOM_64_CHAR_HEX>
ADMIN_KEY=<RANDOM_32_CHAR_HEX>

# ── Encryption (PII at rest) ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=<RANDOM_64_CHAR_HEX>

# ── Image Storage ────────────────────────────────────
# STORAGE_DRIVER selects where uploaded images are stored:
#   r2    (default) — Cloudflare R2; requires the R2_* credentials below.
#   local           — local filesystem (data/uploads/); no cloud creds needed.
#                     For development only — see .env.dev.example.
# STORAGE_DRIVER=r2

# ── Cloudflare R2 Storage (required unless STORAGE_DRIVER=local) ──
R2_ACCOUNT_ID=<YOUR_CF_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY>
R2_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_KEY>
R2_BUCKET_NAME=kodspot-electrical

# ── CORS (comma-separated origins) ───────────────────
CORS_ORIGINS=https://electrical.kodspot.in

# ── Rate Limiting (optional — sensible defaults) ─────
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW=60000
# ADMIN_RATE_LIMIT_MAX=5
# ADMIN_RATE_LIMIT_WINDOW=900000

# ── Email / SES (optional) ──────────────────────────
# SES_SMTP_HOST=
# SES_SMTP_USER=
# SES_SMTP_PASS=
# SES_FROM_EMAIL=

# ── Error Alerting (optional) ───────────────────────
# Get notified on Telegram when server errors occur.
# Create a bot via @BotFather, get chat ID via @userinfobot
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Or use any webhook URL (Slack, Discord, etc.)
# ALERT_WEBHOOK_URL=

# ── AI Assistant — org-level default key (optional) ──
# Used only as a fallback when an organization hasn't configured its own AI key.
# GLOBAL_AI_PROVIDER=azure-openai   # or "gemini"
# GLOBAL_AI_MODEL=gpt-4o
# GLOBAL_AI_API_KEY=

# ── Public Complaint Abuse Detection (optional, recommended in production) ──
# Strengthens the IP-hash used for public-complaint spam/duplicate detection
# against precomputation across deployments. Safe to leave unset (falls back
# to an unpeppered hash) — a startup warning will remind you in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IP_HASH_PEPPER=
